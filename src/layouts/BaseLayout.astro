---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = '记录学习过程与心得的个人博客' } = Astro.props;
const pageTitle = title ? `${title} · t31rycld8的博客` : 't31rycld8的博客';
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href="/">t31rycld8的博客</a>
        <nav class="site-nav" aria-label="主导航">
          <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>首页</a>
          <a href="/archive" aria-current={pathname.startsWith('/archive') ? 'page' : undefined}>归档</a>
          <a href="/about" aria-current={pathname.startsWith('/about') ? 'page' : undefined}>关于</a>
        </nav>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>&copy; {new Date().getFullYear()} t31rycld8的博客</p>
      </div>
    </footer>
  </body>
</html>
